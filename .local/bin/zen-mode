#!/bin/bash
# Zen Mode Toggle Script for Hyprland
set -euo pipefail

# Configuration
HYPR_CONFIG="$HOME/.config/hypr/hyprland.lua"
WAYMOD_SCRIPT="${SCRIPT_DIR:+$SCRIPT_DIR/waymod}"
WAYMOD_SCRIPT="${WAYMOD_SCRIPT:-$HOME/.local/bin/waymod}"

STATE_FILE="$HOME/.cache/waybar/current_preset"

# Presets that should be LEFT ALONE when entering zen mode
KEEP_PRESETS=("top-roman")

# Presets to randomly pick from when waybar needs to change for zen mode
ZEN_PRESETS=("top" "top-modern" "top-roman" "stylish" "bottom")

# Presets to randomly pick from when leaving zen mode (normal/non-zen state)
NORMAL_PRESETS=("float" "dock" "top" "top-modern" "top-roman" "stylish" "bottom")

# Check if zen mode is currently active (line is not commented out)
is_zen_active() {
    grep -q "^require(\"zen\")" "$HYPR_CONFIG"
}

# Read the currently active waybar preset from state, recorded by waymod itself.
# Falls back to "unknown" if waymod has never run, so we default to changing it.
current_waybar_preset() {
    if [[ -f "$STATE_FILE" ]]; then
        cat "$STATE_FILE"
    else
        echo "unknown"
    fi
}

# Check whether a value exists in an array
contains() {
    local needle="$1"; shift
    local x
    for x in "$@"; do
        [[ "$x" == "$needle" ]] && return 0
    done
    return 1
}

# Activate zen mode
activate_zen() {
    sed -i 's/^--[[:space:]]*require("zen")/require("zen")/' "$HYPR_CONFIG"
    echo "Hyprland zen: ON"

    if [[ -x "$WAYMOD_SCRIPT" ]]; then
        local current
        current="$(current_waybar_preset)"

        if contains "$current" "${KEEP_PRESETS[@]}"; then
            echo "Waybar zen: ON (kept as '$current')"
        else
            local pick="${ZEN_PRESETS[$RANDOM % ${#ZEN_PRESETS[@]}]}"
            "$WAYMOD_SCRIPT" "$pick" azure
            echo "Waybar zen: ON ($pick)"
        fi
    fi
}

# Deactivate zen mode
deactivate_zen() {
    sed -i 's/^require("zen")/-- require("zen")/' "$HYPR_CONFIG"
    echo "Hyprland zen: OFF"

    if [[ -x "$WAYMOD_SCRIPT" ]]; then
        local pick="${NORMAL_PRESETS[$RANDOM % ${#NORMAL_PRESETS[@]}]}"
        # "$WAYMOD_SCRIPT" "$pick" azure
        echo "Waybar zen: OFF ($pick)"
    fi
}

# Main logic
case "${1:-toggle}" in
    "on")
        if ! is_zen_active; then
            activate_zen
        fi
        ;;
    "off")
        if is_zen_active; then
            deactivate_zen
        fi
        ;;
    "toggle")
        if is_zen_active; then
            deactivate_zen
        else
            activate_zen
        fi
        ;;
    *)
        echo "Usage: zen-mode [toggle|on|off]"
        exit 1
        ;;
esac
